{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "server.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts",
    "scripts/*.ts",
    "tests/*.ts",
    "tests/server/*.ts",
    "tests/browser/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "referencia",
    "tests/a-migrar"
  ]
}
