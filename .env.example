# Copie para .env.local (ignorado pelo Git). NUNCA versione segredos.
# Sem DATABASE_URL/BETTER_AUTH_SECRET o front sobe, mas a API responde 503 (útil só para ver a interface).

PORT=3000

# --- Neon (projeto "adv-controller") ---
# Duas credenciais DIFERENTES (princípio do menor privilégio):
#
# 1) MIGRAÇÃO = papel dono do esquema (neondb_owner), conexão DIRETA (sem pooler).
#    Só os comandos npm run db:* usam. Nunca vai para o servidor em produção.
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:SENHA@ep-xxxx.REGIAO.aws.neon.tech/BANCO?sslmode=require
#
# 2) RUNTIME = papel adv_runtime (não é dono, sem BYPASSRLS), conexão COM pooler ("-pooler").
#    NÃO preencha à mão: depois de db:migrate, rode
#      npm run db:runtime-login -- --confirm-host=<host direto> --confirm-project=adv-controller
#    que cria a senha, grava esta linha em .env.local (permissão 600) e valida a conexão.
#    Rodar de novo rotaciona a senha. Em produção o servidor se recusa a subir com outro papel.
DATABASE_URL=

# --- Better Auth ---
# Gerar com: openssl rand -base64 32   (mínimo 32 caracteres; nunca reutilize entre ambientes)
BETTER_AUTH_SECRET=
# URL pública do app (https em produção). Define a origem aceita para cookies e CSRF.
BETTER_AUTH_URL=http://127.0.0.1:3000

# Cadastro por conta própria. Padrão: ligado fora de produção, DESLIGADO em produção.
# AUTH_SIGNUP_ENABLED=true

# Saltos de proxy confiáveis (0 = sem proxy). Defina conforme a hospedagem; afeta o limite de taxa por IP.
# TRUST_PROXY=0

# --- Coletor do DJEN ---
# Liga a coleta automática NESTE processo. Padrão: desligado (assim um `npm run dev` nunca consulta o CNJ por engano).
# Ligue em UMA única instância: o coletor é correto com várias (lease/fencing), mas cada uma respeitaria o intervalo
# sozinha e a fonte receberia o dobro do ritmo. Exige hospedagem com processo persistente.
# COLLECTOR_ENABLED=true
# Intervalo mínimo entre o início de duas janelas (ms). Padrão 4000; mínimo 2000 (o limite do CNJ é por origem).
# COLLECTOR_MIN_INTERVAL_MS=4000
# Base da API do DJEN (https). Padrão: a pública do CNJ.
# DJEN_BASE_URL=https://comunicaapi.pje.jus.br/api/v1

# --- E-mail transacional (recuperação de senha, verificação de e-mail e convites) ---
# none   : sem e-mail. Recuperação de senha indisponível; o dono compartilha o link do convite manualmente. (padrão)
# log    : SÓ DESENVOLVIMENTO. Imprime as mensagens (com os links) no terminal. Recusado em produção.
# resend : envia de verdade pelo Resend (https://resend.com). Com ele a verificação de e-mail passa a ser OBRIGATÓRIA para entrar.
# EMAIL_PROVIDER=none
# EMAIL_FROM=Adv Controller <nao-responda@seudominio.com.br>
# RESEND_API_KEY=

