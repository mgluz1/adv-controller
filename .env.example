# Copie para .env.local (ignorado pelo Git). NUNCA versione segredos.
# Sem DATABASE_URL/BETTER_AUTH_SECRET o front sobe, mas a API responde 503 (útil só para ver a interface).

PORT=3000

# --- Neon (projeto "adv-controller") ---
# Conexão COM pooler (host contém "-pooler"): usada pelo servidor em runtime.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/BANCO?sslmode=require
# Conexão DIRETA (sem pooler): usada pelas migrações (npm run db:plan / db:migrate).
DATABASE_URL_UNPOOLED=postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/BANCO?sslmode=require

# --- Better Auth ---
# Gerar com: openssl rand -base64 32   (mínimo 32 caracteres; nunca reutilize entre ambientes)
BETTER_AUTH_SECRET=
# URL pública do app (https em produção). Define a origem aceita para cookies e CSRF.
BETTER_AUTH_URL=http://127.0.0.1:3000

# Cadastro por conta própria. Padrão: ligado fora de produção, DESLIGADO em produção.
# AUTH_SIGNUP_ENABLED=true

# Saltos de proxy confiáveis (0 = sem proxy). Defina conforme a hospedagem; afeta o limite de taxa por IP.
# TRUST_PROXY=0
